---
import Base from '../../layouts/Base.astro';
import PostRow from '../../components/PostRow.astro';
import { getPublishedPosts, getTopics, postsByTopic } from '../../lib/posts';

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  return getTopics(posts).map((topic) => ({
    params: { slug: topic.slug },
    props: { topic, posts: postsByTopic(posts, topic.slug) },
  }));
}

const { topic, posts } = Astro.props;
---

<Base title={topic.name} description={`Notes tagged ${topic.name}.`}>
  <div class="shell section">
    <p class="kicker">Topic</p>
    <h1 class="page-title">{topic.name}</h1>
    <p class="page-intro">{topic.count} {topic.count === 1 ? 'note' : 'notes'} in this track.</p>
    <p><a class="more" href="/topics">All topics</a></p>
    <div class="post-list" style="margin-top: 2rem;">
      {posts.map((post) => (
        <PostRow post={post} />
      ))}
    </div>
  </div>
</Base>
