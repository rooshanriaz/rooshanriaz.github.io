---
import Base from '../layouts/Base.astro';
import GikiLogo from '../components/GikiLogo.astro';
import { site } from '../site.config';

const headings = [
  { id: 'who-i-am', text: 'Who I am' },
  { id: 'education', text: 'Education' },
  { id: 'certifications', text: 'Certifications' },
  { id: 'skills', text: 'Skills' },
  { id: 'why-this-site', text: 'Why this site' },
  { id: 'resume', text: 'Resume' },
  { id: 'get-in-touch', text: 'Get in touch' },
];

const skillGroups = [
  {
    title: 'SOC & Blue Teaming',
    items: [
      ['SIEM', 'Microsoft Sentinel, Splunk, Wazuh, Elastic Security'],
      ['EDR/XDR', 'Microsoft Defender for Endpoint, CrowdStrike Falcon'],
      ['Log Analysis', 'Windows Event Viewer, Sysmon, Windows Event Logs'],
      ['Threat Detection', 'Sigma, YARA, MITRE ATT&CK'],
      ['Threat Intelligence', 'VirusTotal, AbuseIPDB, MISP'],
      ['Security Monitoring', 'Zeek, Suricata'],
      ['Query Languages', 'KQL, SPL'],
      ['Automation & Scripting', 'Python, PowerShell, Bash'],
    ],
  },
  {
    title: 'Network Security',
    items: [
      ['Network Analysis', 'Wireshark, tcpdump, Zeek'],
      ['Network Scanning', 'Nmap'],
      ['IDS/IPS', 'Suricata, Snort'],
      ['Firewalls & Network Defense', 'pfSense, OPNsense'],
      ['Network Fundamentals', 'TCP/IP, DNS, DHCP, HTTP/HTTPS, VLANs, VPNs'],
      ['Traffic Analysis', 'Packet Capture (PCAP), Protocol Analysis, DNS Analysis'],
      ['Network Security Concepts', 'Access Control, Network Segmentation, Firewall Rules'],
    ],
  },
  {
    title: 'Digital Forensics & Incident Response (DFIR)',
    items: [
      ['Memory Forensics', 'Volatility 3'],
      ['Disk Forensics', 'Autopsy, The Sleuth Kit'],
      ['Digital Evidence Collection', 'KAPE, Velociraptor'],
      ['Incident Investigation', 'Windows Event Logs, Sysmon, Timeline Analysis'],
      ['Malware Analysis', 'YARA, Ghidra'],
      ['Incident Response', 'Alert Triage, Threat Containment, Root Cause Analysis'],
      ['Forensic Techniques', 'Evidence Preservation, Chain of Custody, Artifact Analysis'],
    ],
  },
  {
    title: 'Cloud & DevOps Security',
    items: [
      ['Cloud Platforms', 'Microsoft Azure, Amazon Web Services (AWS)'],
      ['Cloud Security', 'Microsoft Defender for Cloud, AWS GuardDuty, AWS CloudTrail'],
      ['Identity & Access Management', 'Microsoft Entra ID, AWS IAM, RBAC, MFA'],
      ['Containers', 'Docker, Kubernetes'],
      ['Infrastructure as Code', 'Terraform'],
      ['CI/CD Security', 'GitHub Actions, GitLab CI/CD'],
      ['DevSecOps', 'Secrets Management, Vulnerability Scanning, Secure Configuration, Container Security'],
      ['Version Control', 'Git, GitHub'],
    ],
  },
  {
    title: 'Security Frameworks & Standards',
    items: [
      ['Frameworks', 'MITRE ATT&CK, NIST Cybersecurity Framework (NIST CSF)'],
      ['Incident Response', 'NIST Incident Response Guidance'],
      ['Controls', 'CIS Critical Security Controls, CIS Benchmarks'],
      ['Standards', 'ISO/IEC 27001'],
      ['Threat Modeling', 'Cyber Kill Chain'],
      ['Application Security', 'OWASP Top 10'],
      ['Detection Rules', 'Sigma Detection Rules, YARA Rules'],
    ],
  },
];
---

<Base title="About" description={`About ${site.name}.`}>
  <div class="shell split section">
    <article class="prose">
      <p class="kicker">About</p>
      <h1 class="page-title">Hi, I am {site.name}.</h1>

      <h2 id="who-i-am">Who I am</h2>
      <p>
        I am {site.name}, a Cyber Security Engineer and GIKI graduate from Pakistan, building a
        career around making systems safer and more resilient. I write about the security work I
        do, the problems I investigate, and what I learn along the way.
      </p>

      <h2 id="education">Education</h2>
      <div class="education-entry">
        <a class="education-mark" href="https://giki.edu.pk/" aria-label="GIKI website">
          <GikiLogo />
        </a>
        <div>
          <p class="education-dates">2022 — 2026</p>
          <h3>Ghulam Ishaq Khan Institute of Engineering Sciences and Technology</h3>
          <p>Cybersecurity · Topi, Pakistan</p>
          <details class="education-courses">
            <summary>View courses studied</summary>
            <ul>
              <li>Data Structures and Algorithms</li>
              <li>Design and Analysis of Algorithms</li>
              <li>Operating Systems</li>
              <li>Database Management Systems</li>
              <li>Computer Communication and Networks</li>
              <li>Information Security</li>
              <li>Cryptography</li>
              <li>Network Security and Information Assurance</li>
              <li>Secure Software Design and Engineering</li>
              <li>Vulnerability Assessment</li>
              <li>Penetration Testing</li>
              <li>Digital Forensics</li>
              <li>Cloud and Distributed Computing</li>
              <li>Intellectual Property and Cyberlaw</li>
              <li>Artificial Intelligence</li>
              <li>Malware Analysis</li>
              <li>AI Security</li>
              <li>DevOps</li>
            </ul>
          </details>
        </div>
      </div>

      <h2 id="skills">Skills</h2>
      <div class="skill-groups">
        {skillGroups.map((group, index) => (
          <details class="skill-group">
            <summary>
              <span class="skill-number">0{index + 1}</span>
              <span>{group.title}</span>
            </summary>
            <ul class="skill-items">
              {group.items.map(([label, tools]) => (
                <li>
                  <strong>{label}</strong>
                  <span>{tools}</span>
                </li>
              ))}
            </ul>
          </details>
        ))}
      </div>

      <h2 id="certifications">Certifications</h2>
      <div class="credential">
        <div>
          <p class="kicker">APIsec University</p>
          <h3>APIsec Certified Professional</h3>
          <p>
            Hands-on API security certification covering API reconnaissance, endpoint analysis,
            authentication and authorization testing, and vulnerability assessment.
          </p>
        </div>
        <a
          class="button ghost"
          href="https://www.credly.com/badges/0b44ec5f-efd1-437e-b7c0-55492680d4fc/linked_in_profile"
        >
          View badge
        </a>
      </div>

      <h2 id="why-this-site">Why this site</h2>
      <p>
        I understand ideas more clearly when I write them down, break them apart, and explain them
        in my own words. This site is that notebook, published. If a note here helps you get
        unstuck, that is a bonus.
      </p>

      <h2 id="resume">Resume</h2>
      <p>
        The long version of what I have done — experience, certs, and projects — lives on a
        printable resume page.
      </p>
      <p>
        <a class="button" href="/resume">View resume</a>
      </p>

      <h2 id="get-in-touch">Get in touch</h2>
      <p>
        Questions, corrections, or just talking shop: reach me at
        {' '}<a class="more" href={`mailto:${site.email}`}>{site.email}</a>.
      </p>
    </article>
    <aside class="toc-inline toc">
      <p>Contents</p>
      <ol>
        {headings.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.text}</a>
          </li>
        ))}
      </ol>
    </aside>
  </div>
</Base>
