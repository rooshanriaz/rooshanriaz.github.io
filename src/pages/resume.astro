---
import Base from '../layouts/Base.astro';
import GikiLogo from '../components/GikiLogo.astro';
import { site } from '../site.config';
---

<Base title="Resume" description={`Resume for ${site.name}.`}>
  <div class="shell section prose">
    <p class="kicker">Resume</p>
    <h1 class="page-title">{site.name}</h1>
    <p class="page-intro">Cybersecurity graduate from GIKI, Pakistan.</p>
    <p>
      <a class="button ghost" href="/about">Back to about</a>
      <a class="button" href={`mailto:${site.email}`}>Email me</a>
    </p>

    <h2>Education</h2>
    <div class="education-entry">
      <a class="education-mark" href="https://giki.edu.pk/" aria-label="GIKI website">
        <GikiLogo />
      </a>
      <div>
        <p class="education-dates">2022 — 2026</p>
        <h3>Ghulam Ishaq Khan Institute of Engineering Sciences and Technology</h3>
        <p>Cybersecurity · Topi, Pakistan</p>
        <details class="education-courses">
          <summary>View courses studied</summary>
          <ul>
            <li>Data Structures and Algorithms</li>
            <li>Design and Analysis of Algorithms</li>
            <li>Operating Systems</li>
            <li>Database Management Systems</li>
            <li>Computer Communication and Networks</li>
            <li>Information Security</li>
            <li>Cryptography</li>
            <li>Network Security and Information Assurance</li>
            <li>Secure Software Design and Engineering</li>
            <li>Vulnerability Assessment</li>
            <li>Penetration Testing</li>
            <li>Digital Forensics</li>
            <li>Cloud and Distributed Computing</li>
            <li>Intellectual Property and Cyberlaw</li>
            <li>Artificial Intelligence</li>
            <li>Malware Analysis</li>
            <li>AI Security</li>
            <li>DevOps</li>
          </ul>
        </details>
      </div>
    </div>

    <h2>Experience</h2>
    <p><strong>Role — Organisation</strong> · Dates</p>
    <p>One or two lines on what you shipped or owned.</p>

    <h2>Certifications</h2>
    <div class="certification-entry">
      <div>
        <p class="certification-meta">APIsec University</p>
        <h3>
          <a href="https://www.credly.com/badges/0b44ec5f-efd1-437e-b7c0-55492680d4fc/linked_in_profile">
            APIsec Certified Professional
          </a>
        </h3>
        <p>
          Hands-on API security certification focused on testing API-driven applications and
          uncovering real-world vulnerabilities.
        </p>
      </div>
      <ul class="skill-list">
        <li>API reconnaissance and endpoint analysis</li>
        <li>OWASP API Security Top 10</li>
        <li>Authentication and authorization testing</li>
        <li>Injection, rate-limit, and misconfiguration testing</li>
      </ul>
    </div>

    <h2>Selected work</h2>
    <ul>
      <li>Point to writeups on this site or public repos.</li>
    </ul>
  </div>
</Base>
